local function GetRoleColor(role)
    if role == "Murderer" then return Theme.Red end
    if role == "Sheriff" then return Theme.Blue end
    return Theme.Green
end

local function UpdateProfile(player)
    for _, v in ipairs(ProfileArea:GetChildren()) do
        if v:IsA("Frame") or v:IsA("TextLabel") then v:Destroy() end
    end
    
    if not player then
        create("TextLabel", {Text = "Select a player", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0, 20), BackgroundTransparency = 1, TextColor3 = Theme.Muted, Font = Enum.Font.Gotham, TextSize = 14}, ProfileArea)
        return
    end

    local TopInfo = create("Frame", {Size = UDim2.new(1, -20, 0, 60), Position = UDim2.new(0, 10, 0, 10), BackgroundTransparency = 1}, ProfileArea)
    create("ImageLabel", {Size = UDim2.new(0, 50, 0, 50), BackgroundColor3 = Theme.Sidebar, Image = "rbxthumb://type=AvatarHeadShot&id="..player.UserId.."&w=150&h=150"}, TopInfo)
    create("TextLabel", {Text = player.DisplayName, Size = UDim2.new(1, -60, 0, 25), Position = UDim2.new(0, 60, 0, 0), BackgroundTransparency = 1, TextColor3 = Theme.Text, Font = Enum.Font.GothamBold, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left}, TopInfo)
    create("TextLabel", {Text = "@" .. player.Name, Size = UDim2.new(1, -60, 0, 20), Position = UDim2.new(0, 60, 0, 25), BackgroundTransparency = 1, TextColor3 = Theme.Muted, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left}, TopInfo)

    local RoleFrame = create("Frame", {Size = UDim2.new(1, -20, 0, 60), Position = UDim2.new(0, 10, 0, 80), BackgroundColor3 = Theme.Sidebar}, ProfileArea)
    addCorner(RoleFrame, 8)
    
    -- Role Simulation for MM2 style
    local mockRole = "Innocent" 
    if player.UserId % 3 == 0 then mockRole = "Murderer" elseif player.UserId % 2 == 0 then mockRole = "Sheriff" end
    
    create("TextLabel", {Text = "Role", Size = UDim2.new(1, -20, 0, 20), Position = UDim2.new(0, 10, 0, 5), BackgroundTransparency = 1, TextColor3 = Theme.Muted, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left}, RoleFrame)
    create("TextLabel", {Text = mockRole, Size = UDim2.new(1, -20, 0, 25), Position = UDim2.new(0, 10, 0, 25), BackgroundTransparency = 1, TextColor3 = GetRoleColor(mockRole), Font = Enum.Font.GothamBold, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left}, RoleFrame)

    local btnSpectate = create("TextButton", {Text = "👁 Spectate", Size = UDim2.new(1, -20, 0, 35), Position = UDim2.new(0, 10, 0, 150), BackgroundColor3 = Theme.Sidebar, TextColor3 = Theme.Text, Font = Enum.Font.Gotham, TextSize = 13}, ProfileArea)
    addCorner(btnSpectate, 6)
    btnSpectate.MouseButton1Click:Connect(function()
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            workspace.CurrentCamera.CameraSubject = player.Character.Humanoid
        end
    end)

    local btnTp = create("TextButton", {Text = "🚀 Teleport to Player", Size = UDim2.new(1, -20, 0, 35), Position = UDim2.new(0, 10, 0, 195), BackgroundColor3 = Theme.Sidebar, TextColor3 = Theme.Text, Font = Enum.Font.Gotham, TextSize = 13}, ProfileArea)
    addCorner(btnTp, 6)
    btnTp.MouseButton1Click:Connect(function()
        if player.Character and LocalPlayer.Character then
            LocalPlayer.Character.HumanoidRootPart.CFrame = player.Character.HumanoidRootPart.CFrame
        end
    end)

    local btnKick = create("TextButton", {Text = "🚫 Kick", Size = UDim2.new(0.5, -15, 0, 35), Position = UDim2.new(0, 10, 0, 250), BackgroundColor3 = Theme.Red, TextColor3 = Theme.Text, Font = Enum.Font.GothamBold, TextSize = 13}, ProfileArea)
    addCorner(btnKick, 6)
    btnKick.MouseButton1Click:Connect(function()
        for _, obj in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
            if obj:IsA("RemoteEvent") and (obj.Name:lower():find("kick") or obj.Name:lower():find("ban")) then
                pcall(function() obj:FireServer(player) end)
            end
        end
    end)
end

local function RefreshList()
    for _, v in ipairs(PlayerList:GetChildren()) do
        if v:IsA("TextButton") then v:Destroy() end
    end
    
    local players = Players:GetPlayers()
    PlayerCountLabel.Text = #players .. "/" .. #players

    for i, plr in ipairs(players) do
        local row = create("TextButton", {Size = UDim2.new(1, -4, 0, 40), BackgroundColor3 = Theme.Sidebar, BackgroundTransparency = 0.5, Text = "", LayoutOrder = i}, PlayerList)
        addCorner(row, 6)
        
        create("TextLabel", {Text = i, Size = UDim2.new(0, 30, 1, 0), Position = UDim2.new(0, 5, 0, 0), BackgroundTransparency = 1, TextColor3 = Theme.Muted, Font = Enum.Font.Gotham, TextSize = 12}, row)
        
        local avatar = create("ImageLabel", {Size = UDim2.new(0, 28, 0, 28), Position = UDim2.new(0, 35, 0, 6), BackgroundColor3 = Theme.Panel, Image = "rbxthumb://type=AvatarHeadShot&id="..plr.UserId.."&w=48&h=48"}, row)
        addCorner(avatar, 14)
        
        create("TextLabel", {Text = plr.DisplayName, Size = UDim2.new(0, 150, 1, 0), Position = UDim2.new(0, 70, 0, 0), BackgroundTransparency = 1, TextColor3 = Theme.Text, Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left}, row)
        
        local mockRole = "Innocent"
        local rColor = Theme.Green
        if plr.UserId % 3 == 0 then mockRole = "Murderer"; rColor = Theme.Red elseif plr.UserId % 2 == 0 then mockRole = "Sheriff"; rColor = Theme.Blue end
        
        create("TextLabel", {Text = mockRole, Size = UDim2.new(0, 100, 1, 0), Position = UDim2.new(0, 200, 0, 0), BackgroundTransparency = 1, TextColor3 = rColor, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left}, row)
        
        row.MouseButton1Click:Connect(function()
            State.SelectedPlayer = plr
            UpdateProfile(plr)
            for _, child in ipairs(PlayerList:GetChildren()) do
                if child:IsA("TextButton") then child.BackgroundColor3 = Theme.Sidebar end
            end
            row.BackgroundColor3 = Theme.AccentDark
        end)
    end
end

-- Cheats Tab
local function ShowCheatsTab()
    for _, v in ipairs(MainArea:GetChildren()) do v.Visible = false end
    
    local CheatFrame = MainArea:FindFirstChild("CheatFrame")
    if not CheatFrame then
        CheatFrame = create("Frame", {Name = "CheatFrame", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1}, MainArea)
        create("TextLabel", {Text = "⚡ CHEAT FUNCTIONS", Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 20, 0, 20), BackgroundTransparency = 1, TextColor3 = Theme.Text, Font = Enum.Font.GothamBold, TextSize = 20, TextXAlignment = Enum.TextXAlignment.Left}, CheatFrame)

        local flyBtn = create("TextButton", {Text = "Fly: OFF", Size = UDim2.new(0.8, 0, 0, 40), Position = UDim2.new(0.1, 0, 0, 80), BackgroundColor3 = Theme.Sidebar, TextColor3 = Theme.Text, Font = Enum.Font.Gotham}, CheatFrame)
        addCorner(flyBtn, 8)
        flyBtn.MouseButton1Click:Connect(function()
            State.Flying = not State.Flying
            flyBtn.Text = "Fly: " .. (State.Flying and "ON" or "OFF")
            flyBtn.BackgroundColor3 = State.Flying and Theme.Green or Theme.Sidebar
            
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if State.Flying and hrp then
                local bv = Instance.new("BodyVelocity", hrp)
                bv.Name = "CheatFly"
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.new(0,0,0)
                RunService.RenderStepped:Connect(function()
                    if not State.Flying or not bv.Parent then return end
                    local moveDir = Vector3.new(0,0,0)
                    local cam = workspace.CurrentCamera
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += cam.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= cam.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= cam.CFrame.RightVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += cam.CFrame.RightVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0,1,0) end
                    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir -= Vector3.new(0,1,0) end
                    bv.Velocity = moveDir.Magnitude > 0 and moveDir.Unit * 50 or Vector3.new(0,0,0)
                end)
            else
                if hrp then
                    local bv = hrp:FindFirstChild("CheatFly")
                    if bv then bv:Destroy() end
                end
            end
        end)

        local noclipBtn = create("TextButton", {Text = "Noclip: OFF", Size = UDim2.new(0.8, 0, 0, 40), Position = UDim2.new(0.1, 0, 0, 130), BackgroundColor3 = Theme.Sidebar, TextColor3 = Theme.Text, Font = Enum.Font.Gotham}, CheatFrame)
        addCorner(noclipBtn, 8)
        noclipBtn.MouseButton1Click:Connect(function()
            State.Noclip = not State.Noclip
            noclipBtn.Text = "Noclip: " .. (State.Noclip and "ON" or "OFF")
            noclipBtn.BackgroundColor3 = State.Noclip and Theme.Green or Theme.Sidebar
        end)
        RunService.Stepped:Connect(function()
            if State.Noclip and LocalPlayer.Character then
                for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
                    if v:IsA("BasePart") then v.CanCollide = false end
                end
            end
        end)
    end
    CheatFrame.Visible = true
end

