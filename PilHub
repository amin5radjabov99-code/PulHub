local function SidebarBtn(text, order)
    local btn = create("TextButton", {Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = Theme.Sidebar, BackgroundTransparency = 1, Text = "  " .. text, TextColor3 = Theme.Muted, Font = Enum.Font.GothamMedium, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = order}, Sidebar)
    addCorner(btn, 6)
    btn.MouseEnter:Connect(function() TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.8, TextColor3 = Theme.Text}):Play() end)
    btn.MouseLeave:Connect(function() TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 1, TextColor3 = Theme.Muted}):Play() end)
    return btn
end

